# Scripts that run inside Linux containers or WSL must keep LF endings:
# a CRLF checkout breaks entrypoint.sh (/usr/bin/env: 'bash\r') and every
# bash script. Windows helper scripts get CRLF instead.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.conf text eol=lf
# everything copied into the Linux image via COPY root/. / must stay LF,
# including extension-less scripts like root/usr/local/bin/xdg-open
root/** text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.psm1 text eol=crlf
